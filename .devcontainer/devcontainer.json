{
  "name": "uFawkesObs Development",
  "image": "ghcr.io/paruff/fawkes-space:2.0.0-rc.3@sha256:491546e9fdef2b473899e152e0631a94b8d68fadb6525d39fb72cdfab08c08e0",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "streetsidesoftware.code-spell-checker",
        "yzhao062.agent-style"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "github.copilot.enable": {
          "*": true
        }
      }
    }
  },
  "forwardPorts": [
    9090,
    3000
  ],
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "postCreateCommand": "bash -c 'set -e; export PATH=\"$HOME/.local/bin:/usr/local/bin:$PATH\"; ./.devcontainer/install-tools.sh'"
}
