{
  "name": "uFawkesObs Development",
  "image": "ghcr.io/paruff/fawkes-space:2.2.0@sha256:f5d07e71c3d471e46d1825bd7dcfabec640dfa31801dbf94c48465bd5d4caf70",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "streetsidesoftware.code-spell-checker",
        "yzhao062.agent-style"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "github.copilot.enable": {
          "*": true
        }
      }
    }
  },
  "forwardPorts": [
    9090,
    3000
  ],
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "postCreateCommand": "bash -c 'set -e; export PATH=\"$HOME/.local/bin:/usr/local/bin:$PATH\"; ./.devcontainer/install-tools.sh' && pre-commit install && pre-commit install-hooks && bash scripts/shift-left.sh doctor",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}
