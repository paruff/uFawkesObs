# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/


# Graphify knowledge graph (build artifact, regenerated by hooks)
graphify-out/

# Agent memory/cache databases
.headroom/

# Feature lifecycle working files (overwritten per-feature, cause merge conflicts)
# Root-anchored: only the transient root-level copies, not docs/product/ or docs/features/
/specification.md
/design.md
/tasks.json
*-report.md
/ci-diagnosis.md

# Lighthouse artifacts
.unlighthouse/

# Backup files
*.bak

# Serena MCP local cache/config
.serena/
