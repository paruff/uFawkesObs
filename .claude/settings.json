{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-remote-compose-up.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect-tests.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verify-changed-files.sh",
            "timeout": 300
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/shift-left.sh\" agent-gate",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/shift-left.sh\" doctor --quiet || true"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "grafana-skills": {
      "source": {
        "source": "github",
        "repo": "grafana/skills",
        "ref": "8fb72a527961f05e708f53d2a0500709e12d7970"
      }
    },
    "opentelemetry-agent-skills": {
      "source": {
        "source": "github",
        "repo": "ollygarden/opentelemetry-agent-skills",
        "ref": "c902846a75eef3b94384abee5e20107008698e92"
      }
    }
  },
  "enabledPlugins": {
    "grafana-core@grafana-skills": true,
    "grafana-lgtm@grafana-skills": true,
    "otel-collector@opentelemetry-agent-skills": true,
    "otel-ottl@opentelemetry-agent-skills": true
  }
}
